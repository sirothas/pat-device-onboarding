<!--
  PAT-Onboarding-Setup.exe - the ONE file an employee runs (or IT pushes). Chains:
    1. the OpenVPN community MSI, UNMODIFIED (it keeps OpenVPN Inc.'s own signature), Permanent:
       uninstalling onboarding must never remove the tunnel a joined laptop depends on;
    2. PAT-Onboarding.msi (the helper);
  then launches the helper ELEVATED through the engine (LaunchTargetElevatedId), so the employee sees
  ONE UAC prompt for the whole thing.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:bal="http://wixtoolset.org/schemas/v4/wxs/bal">
  <Bundle Name="PAT Company Laptop Onboarding"
          Manufacturer="Parvati Axis Technologies Pvt Ltd"
          Version="$(Version)"
          UpgradeCode="e46ce37c-b210-47d4-9f4f-4d5ed70bdc63">
    <BootstrapperApplication>
      <bal:WixStandardBootstrapperApplication Theme="hyperlinkSidebarLicense"
                                              LicenseUrl="https://github.com/sirothas/pat-device-onboarding/blob/main/LICENSE"
                                              LaunchTargetElevatedId="Helper"
                                              LaunchArguments="--portal &quot;[PORTAL_URL]&quot;" />
    </BootstrapperApplication>

    <ApprovedExeForElevation Id="Helper" Key="SOFTWARE\PAT\Onboarding" Value="HelperPath" />

    <!-- Optional hint from IT: PAT-Onboarding-Setup.exe PORTAL_URL=https://... -->
    <Variable Name="PORTAL_URL" bal:Overridable="yes" Value="" />

    <Chain>
      <MsiPackage SourceFile="$(OpenVpnMsi)" Permanent="yes" Vital="yes" Visible="yes" />
      <MsiPackage SourceFile="$(OnboardingMsi)" Vital="yes">
        <MsiProperty Name="PORTAL_URL" Value="[PORTAL_URL]" />
      </MsiPackage>
    </Chain>
  </Bundle>
</Wix>
